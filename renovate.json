{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/fedora/fedora-iot"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "schedule": [
        "* 0 * * */3"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/fedora/fedora-iot",
        "ghcr.io/ublue-os/brew"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "matchDatasources": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/fedora/fedora-iot",
        "ghcr.io/ublue-os/brew",
        "ghcr.io/slskd/slskd",
        "quay.io/cockpit/ws"
      ],
      "pinDigests": true
    }
  ],
  "prHourlyLimit": 0,
  "quadlet": {
    "managerFilePatterns": [
      "/.+\\.container.d/.+\\.conf$/"
    ]
  }
}
