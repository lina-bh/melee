{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "quay.io/fedora/fedora-iot"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/fedora/fedora-iot",
        "ghcr.io/ublue-os/brew"
      ],
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "pinDigests": true,
      "automerge": true
    },
    {
      "matchDatasources": [
        "docker",
        "github-actions"
      ],
      "pinDigests": true
    }
  ],
  "prHourlyLimit": 0,
  "quadlet": {
    "managerFilePatterns": [
      "/^system_files\\/etc\\/containers\\/systemd\\/.+\\.container/",
      "/^system_files\\/etc\\/containers\\/systemd\\/.+\\.container.d\\/.+\\.conf/"
    ]
  }
}
