{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/fedora/fedora-iot",
        "ghcr.io/ublue-os/brew"
      ],
      "enabled": true,
      "pinDigests": true,
      "automerge": true
    },
    {
      "matchDatasources": [
        "docker",
        "kubernetes",
        "kustomize",
        "github-actions"
      ],
      "pinDigests": true
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^system_files/etc/kubernetes/manifests/.+\\.yaml$/",
      "/^apps/.+\\.ya?ml$/"
    ]
  },
  "prHourlyLimit": 0
}
