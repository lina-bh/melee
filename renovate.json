{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "customManagers:dockerfileVersions",
    "docker:pinDigests"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/fedora/fedora-iot"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "k3s-io/k3s"
      ],
      "separateMultipleMinor": true
    }
  ],
  "prHourlyLimit": 0,
  "automergeType": "branch",
  "ignoreTests": true,
  "quadlet": {
    "managerFilePatterns": [
      "/.+\\.container.d/.+\\.conf$/"
    ]
  }
}
