{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/fedora/fedora-iot"],
      "versioning": "loose"
    },
    {
      "enabled": "false",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/fedora/fedora-iot"],
      "matchUpdateTypes": ["major"]
    },
    {
      "matchDatasources": ["docker", "kubernetes", "kustomize"],
      "pinDigests": true
    },
  ],
  "kubernetes": {
    "managerFilePatterns": ["/^system_files/etc/kubernetes/manifests/etcd\\.yaml$/"]
  }
}
