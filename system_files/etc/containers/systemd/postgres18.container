[Container]
Environment=POSTGRES_HOST_AUTH_METHOD=trust
Image=registry.access.redhat.com/hi/postgresql:18@sha256:d6cfb70eb81d7843ead5e516b40ceaff10166f9449cb57ac8bbee33688cb26d3
Network=postgres18.network
NetworkAlias=postgres18
Mount=type=volume,source=postgres18-data.volume,destination=/var/lib/postgresql/data/,chown=true
ReadOnly=true
UserNS=auto:uidmapping=999:26:1,gidmapping=999:26:1
