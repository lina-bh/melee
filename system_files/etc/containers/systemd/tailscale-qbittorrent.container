[Container]
Environment=TS_SERVE_CONFIG=/serve.json
Mount=type=volume,source=tailscale-qbittorrent.volume,destination=/var/lib/tailscale,chown=true
Mount=type=bind,source=./serve/qbittorrent.json,destination=/serve.json,readonly=true,relabel=private
Secret=tskey-auth,type=env,target=TS_AUTHKEY
Pod=qbittorrent.pod
User=99:99
