[Unit]
Wants=tailscaled.service

[Container]
AddCapability=SYS_PTRACE
AddCapability=SYS_ADMIN
AddCapability=DAC_OVERRIDE
Entrypoint=["/container/label-run"]
Exec=--address=127.0.0.1
Image=quay.io/cockpit/ws:365@sha256:c7d71650e63cc6023f1e80b62f7612bfa08bad8acaaf0b7b5dc4dee2b12cb3ff
Mount=type=bind,source=/,destination=/host,bind-propagation=rslave
Network=host
SecurityLabelDisable=true
StopSignal=SIGKILL

[Service]
ExecStartPost=-/usr/bin/tailscale serve --bg --yes https+insecure://localhost:9090
SuccessExitStatus=0 137

[Install]
WantedBy=default.target
